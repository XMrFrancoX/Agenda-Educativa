# Variables de entorno — Agenda Educativa
# Copiar este archivo como .env y completar los valores reales
# NUNCA commitear el archivo .env (está en .gitignore)

# Dominio canónico de la app (sin trailing slash) — usado para links de
# invitación/contraseña en vez de url.origin, porque una escuela puede
# tener custom_domain propio que no está en la lista de Redirect URLs de Supabase.
PUBLIC_SITE_URL=http://localhost:5174

# ─── Supabase ────────────────────────────────────────────────────────
# Dashboard → Settings → API
PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Email — Resend ──────────────────────────────────────────────────
# Crear cuenta gratuita en https://resend.com (3,000 emails/mes gratis)
# Dashboard → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dominio verificado en Resend (o usar onboarding@resend.dev para testing)
EMAIL_FROM=Agenda Educativa <notificaciones@tudominio.edu.ar>

# ─── WhatsApp — Twilio ───────────────────────────────────────────────
# Crear cuenta en https://www.twilio.com (tiene crédito gratuito de prueba)
# Dashboard → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Número de WhatsApp de Twilio (Sandbox para testing)
# Sandbox: whatsapp:+14155238886
# Producción: tu número aprobado por Meta
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Content Template SID (solo para producción con templates aprobados)
# Dashboard → Content → Templates
TWILIO_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Seguridad ───────────────────────────────────────────────────────
# String aleatorio para proteger endpoints internos
CRON_SECRET=cambia-esto-por-un-string-aleatorio-seguro-32-chars

# ─── Monitoreo de errores — Sentry ─────────────────────────────────────
# Solo client-side (hooks.client.ts) — el server-side de @sentry/sveltekit
# rompe el runtime de Cloudflare Workers, no usarlo.
PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
